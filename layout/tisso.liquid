<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title | escape }} – {{ shop.name | escape }}</title>
    {{ content_for_header }}
    {{ 'tisso-gift-guide.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'tisso-gift-guide.js' | asset_url }}" defer></script>
  </head>
  <body class="tisso-page">
    <a class="tisso-skip" href="#MainContent">Skip to content</a>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
