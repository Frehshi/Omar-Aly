{% comment %}Original banner; all copy and artwork can be changed in the theme editor.{% endcomment %}
{% assign medium_font = section.settings.body_font | font_modify: 'weight', '500' %}
{% style %}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {{ medium_font | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }} {
    --tisso-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --tisso-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }
{% endstyle %}
<tisso-banner class="tisso-banner">
  <header class="tisso-bar">
    <button class="tisso-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="TissoMenu-{{ section.id }}">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M1 5h18M1 10h18M1 15h18" fill="none" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <a class="tisso-brand" href="{{ routes.root_url }}">{{ section.settings.brand | escape }}</a>
    <p class="tisso-bar-message">{{ section.settings.top_message | escape }}</p>
    <a class="tisso-button tisso-button--yellow tisso-top-button" href="{{ section.settings.choose_link | default: '#tisso-products' }}">
      <span>{{ section.settings.choose_label | escape }}</span><span class="tisso-arrow" aria-hidden="true">⟶</span>
    </a>
    <nav class="tisso-mobile-menu" id="TissoMenu-{{ section.id }}" aria-label="Gift guide menu" hidden>
      <p>{{ section.settings.top_message | escape }}</p>
      <a href="{{ section.settings.choose_link | default: '#tisso-products' }}">{{ section.settings.choose_label | escape }}</a>
      <a href="{{ routes.cart_url }}">Cart</a>
    </nav>
  </header>
  <div class="tisso-hero">
    <div class="tisso-art tisso-art--top" aria-hidden="true">
      {% if section.settings.desktop_art != blank %}
        {{ section.settings.desktop_art | image_url: width: 2880 | image_tag: loading: 'eager', widths: '750, 1440, 2880', sizes: '100vw', alt: '' }}
      {% else %}
        <img src="{{ 'tisso-illustration.svg' | asset_url }}" width="1052" height="400" alt="" fetchpriority="high">
      {% endif %}
    </div>
    <div class="tisso-hero-copy">
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="tisso-description tisso-description--desktop">{{ section.settings.description | escape | newline_to_br }}</p>
      <p class="tisso-description tisso-description--mobile">{{ section.settings.mobile_description | escape | newline_to_br }}</p>
      <a class="tisso-button tisso-shop-button" href="{{ section.settings.shop_link | default: '#tisso-products' }}">
        <span>{{ section.settings.shop_label | escape }}</span><span class="tisso-arrow" aria-hidden="true">⟶</span>
      </a>
    </div>
    <div class="tisso-art tisso-art--bottom" aria-hidden="true">
      {% if section.settings.mobile_art != blank %}
        {{ section.settings.mobile_art | image_url: width: 1500 | image_tag: loading: 'eager', class: 'tisso-mobile-art', alt: '' }}
      {% endif %}
      {% if section.settings.desktop_art != blank %}
        {{ section.settings.desktop_art | image_url: width: 2880 | image_tag: loading: 'eager', class: 'tisso-default-art', alt: '' }}
      {% else %}
        <img class="tisso-default-art" src="{{ 'tisso-illustration.svg' | asset_url }}" width="1052" height="400" alt="">
      {% endif %}
    </div>
  </div>
  <div class="tisso-strip">
    <span class="tisso-strip-desktop">{{ section.settings.bottom_message | escape }}</span>
    <span class="tisso-strip-mobile">{{ section.settings.mobile_bottom_message | escape }}</span>
  </div>
</tisso-banner>
{% schema %}
{
  "name": "Tisso Banner",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand", "default": "TISSO VISON" },
    { "type": "text", "id": "top_message", "label": "Top message", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "choose_label", "label": "Choose gift button", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "choose_link", "label": "Choose gift link" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "description", "label": "Desktop description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to\ndelight your loved ones this holiday season." },
    { "type": "textarea", "id": "mobile_description", "label": "Mobile description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination." },
    { "type": "text", "id": "shop_label", "label": "Shop button", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_link", "label": "Shop button link" },
    { "type": "text", "id": "bottom_message", "label": "Bottom message", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" },
    { "type": "text", "id": "mobile_bottom_message", "label": "Mobile bottom message", "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR" },
    { "type": "image_picker", "id": "desktop_art", "label": "Illustration override" },
    { "type": "image_picker", "id": "mobile_art", "label": "Mobile illustration override" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "jost_n4" },
    { "type": "font_picker", "id": "heading_font", "label": "Banner heading font", "default": "jost_n6" }
  ],
  "presets": [{ "name": "Tisso Banner" }]
}
{% endschema %}
