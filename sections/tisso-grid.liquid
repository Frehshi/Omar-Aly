{% comment %}Six original product blocks share one accessible popup and one delegated controller.{% endcomment %}
{% liquid
  assign bonus_product = section.settings.bonus_product
  if bonus_product == blank
    assign bonus_product = all_products['soft-winter-jacket']
  endif
  assign bonus_variant = bonus_product.selected_or_first_available_variant
  assign light_font = section.settings.body_font | font_modify: 'weight', '300'
%}
{% style %}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {{ light_font | font_face: font_display: 'swap' }}
  @font-face { font-family: 'Lustria'; src: url('{{ 'tisso-lustria.ttf' | asset_url }}') format('truetype'); font-style: normal; font-weight: 400; font-display: swap; }
  #shopify-section-{{ section.id }} {
    --tisso-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --tisso-grid-font: {{ section.settings.heading_font }}, Georgia, serif;
  }
{% endstyle %}
<tisso-grid class="tisso-grid" id="tisso-products" data-cart-add="{{ routes.cart_add_url }}.js" data-cart-url="{{ routes.cart_url }}" data-bonus-id="{{ bonus_variant.id }}" data-bonus-available="{{ bonus_variant.available }}">
  <h2 class="tisso-grid-heading">{{ section.settings.heading | escape }}</h2>
  <div class="tisso-products">
    {% for block in section.blocks %}
      {% liquid
        assign product = block.settings.product
        assign look = block.settings.image
        assign fallback = 'tisso-look-' | append: forloop.index | append: '.png'
      %}
      <article class="tisso-product" {{ block.shopify_attributes }}>
        {% if look != blank %}
          {{ look | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 500, 750, 1000', sizes: '(max-width: 749px) 50vw, 33vw', alt: product.title }}
        {% else %}
          <img src="{{ fallback | asset_url }}" width="433" height="444" alt="{{ product.title | default: 'Gift guide look' | escape }}" loading="lazy">
        {% endif %}
        {% if product != blank %}
          <button class="tisso-hotspot" type="button" style="--hotspot-x:{{ block.settings.x }}%;--hotspot-y:{{ block.settings.y }}%;--hotspot-mobile-x:{{ block.settings.mobile_x }}%;--hotspot-mobile-y:{{ block.settings.mobile_y }}%" data-product-key="{{ block.id }}" aria-label="View {{ product.title | escape }}" aria-haspopup="dialog" aria-controls="TissoDialog-{{ section.id }}">
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1v10M1 6h10" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
          </button>
          <script type="application/json" data-product-json="{{ block.id }}">
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json | replace: '<', '\u003c' }},
              "description": {{ product.description | strip_html | json | replace: '<', '\u003c' }},
              "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}{{ fallback | asset_url | json }}{% endif %},
              "hasDefaultVariant": {{ product.has_only_default_variant | json }},
              "options": {{ product.options_with_values | json | replace: '<', '\u003c' }},
              "variants": [
                {% for variant in product.variants %}
                  {
                    "id": {{ variant.id | json }},
                    "available": {{ variant.available | json }},
                    "options": {{ variant.options | json | replace: '<', '\u003c' }},
                    "price": {{ variant.price | money | strip_html | json | replace: '<', '\u003c' }},
                    "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>
        {% elsif request.design_mode %}
          <span class="tisso-editor-note">Select a product for this block</span>
        {% endif %}
      </article>
    {% endfor %}
  </div>
  <dialog class="tisso-dialog" id="TissoDialog-{{ section.id }}" aria-labelledby="TissoTitle-{{ section.id }}">
    <button class="tisso-close" type="button" aria-label="Close product popup">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="m1 1 12 12M1 13 13 1" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
    <div class="tisso-summary">
      <img class="tisso-popup-image" width="120" height="140" alt="">
      <div>
        <h3 id="TissoTitle-{{ section.id }}" class="tisso-popup-title"></h3>
        <p class="tisso-popup-price" aria-live="polite"></p>
        <p class="tisso-popup-description"></p>
      </div>
    </div>
    <form class="tisso-product-form">
      <div class="tisso-options"></div>
      <p class="tisso-status" role="status" aria-live="polite"></p>
      <button class="tisso-button tisso-add" type="submit" disabled>
        <span data-add-label>ADD TO CART</span><span class="tisso-arrow" aria-hidden="true">⟶</span>
      </button>
    </form>
  </dialog>
</tisso-grid>
{% schema %}
{
  "name": "Tisso Grid",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" },
    { "type": "product", "id": "bonus_product", "label": "Soft Winter Jacket", "info": "Select the Soft Winter Jacket product. Its first available variant is also added for every Black + Medium selection." },
    { "type": "font_picker", "id": "body_font", "label": "Popup font", "default": "jost_n4" },
    { "type": "select", "id": "heading_font", "label": "Grid heading font", "options": [{ "value": "Lustria", "label": "Lustria (Figma)" }, { "value": "Georgia", "label": "Georgia" }], "default": "Lustria" }
  ],
  "blocks": [{
    "type": "product",
    "name": "Product",
    "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "image_picker", "id": "image", "label": "Grid photograph override", "info": "Leave empty to use the original Figma photograph for this position." },
      { "type": "range", "id": "x", "label": "Desktop circle horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 62 },
      { "type": "range", "id": "y", "label": "Desktop circle vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 55 },
      { "type": "range", "id": "mobile_x", "label": "Mobile circle horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 65 },
      { "type": "range", "id": "mobile_y", "label": "Mobile circle vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 14 }
    ]
  }],
  "presets": [{ "name": "Tisso Grid", "blocks": [{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}] }]
}
{% endschema %}
